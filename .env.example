# SPHEREx Blink Observatory — Environment Variables
# Copy to .env and fill in optional credentials. The service starts and passes offline tests with defaults.

# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
PIPELINE_VERSION=1.0.0

# SPHEREx IRSA Archive (V-01, V-02, V-03)
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP/sync
IRSA_CUTOUT_BASE_URL=https://irsa.ipac.caltech.edu
SPHEREX_RELEASES=["spherex_dr1","spherex_dr1_deep","spherex_qr3","spherex_qr3_deep"]
SPHEREX_REJECT_FLAG_BITS=[0,1,2,6,9,10,11,15,17,19,25,26,27]
SPHEREX_CUTOUT_MAX_FOV_DEG=0.5
SPHEREX_CUTOUT_CONCURRENCY=6
SPHEREX_HTTP_TIMEOUT_SEC=30.0
SPHEREX_HTTP_RETRIES=2
# Science Pipeline Thresholds
MATCH_RADIUS_ARCSEC=12.0
GAIA_MATCH_RADIUS_ARCSEC=3.5
DETECTION_SIGMA=3.2
MIN_SNR=4.5
PM_SIGNIFICANCE_SIGMA=3.0
VARIABILITY_REDUCED_CHI2=6.0
BAND_MATCH_FRACTION=0.5

# External Catalogs & Literature
GAIA_TAP_URL=https://gea.esac.esa.int/tap-server/tap/sync
SIMBAD_TAP_URLS=["https://simbad.harvard.edu/simbad/sim-tap/sync","https://simbad.cds.unistra.fr/simbad/sim-tap/sync"]
VIZIER_URLS=["https://vizier.cfa.harvard.edu/viz-bin/votable","https://vizier.cds.unistra.fr/viz-bin/votable"]
NED_URL=https://ned.ipac.caltech.edu/cgi-bin/objsearch
CADC_TAP_URL=https://ws.cadc-ccda.hia-iha.nrc-cnrc.gc.ca/argus/sync
HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api
NASA_ADS_API_TOKEN=
NASA_ADS_API_URL=https://api.adsabs.harvard.edu/v1/search/query
# Optional Tavily search for NASA and NASA/IPAC evidence in the narrator
TAVILY_API_KEY=

# Storage & Cache
DATABASE_URL=postgresql+psycopg://spherex:spherex@localhost:5432/spherex
REDIS_URL=redis://localhost:6379/0
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=86400

# LLM Provider (Cosmic Narrator & Ask This Patch)
# Supports: template (no key needed), fake (tests), openai_compatible
LLM_PROVIDER=template
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_DIM=384

# Rate Limiting (per client IP per minute)
NARRATIVE_RATE_LIMIT_PER_MIN=20
ASK_RATE_LIMIT_PER_MIN=30
ASK_MAX_QUESTION_CHARS=500
